    "paste.documentHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The format is suggested from your text. You can change it before saving to Recent Files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已根据文本选择格式。你可以调整格式，然后保存到最近文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已根據文字選擇格式。你可以調整格式，然後儲存到最近檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストから形式を判別します。形式を変更してから「最近使ったファイル」に保存できます。"
          }
        }
      }
    },
    "paste.preview": {
      "extractionState": "manual",
      "localizations": {
