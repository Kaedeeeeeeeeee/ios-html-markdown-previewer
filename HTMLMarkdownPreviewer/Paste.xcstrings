    "paste.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste HTML or Markdown text here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这里粘贴 HTML 或 Markdown 文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這裡貼上 HTML 或 Markdown 文字。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTML または Markdown のテキストをここに貼り付けます。"
          }
        }
      }
    },
    "paste.contentHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste HTML or Markdown content. Text stays on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴 HTML 或 Markdown 正文。文本保存在此设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上 HTML 或 Markdown 內容。文字會儲存在此裝置上。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTML または Markdown の内容を貼り付けます。テキストはこのデバイスに保存されます。"
          }
        }
      }
    },
