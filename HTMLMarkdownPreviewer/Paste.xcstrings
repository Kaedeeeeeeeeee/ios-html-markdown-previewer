    },
    "paste.cannotPreview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot Preview Text"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法预览文本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法預覽文字"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストをプレビューできません"
          }
        }
      }
    },
    "paste.error.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste or enter some HTML or Markdown text first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先粘贴或输入 HTML 或 Markdown 文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先貼上或輸入 HTML 或 Markdown 文字。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTML または Markdown のテキストを貼り付けるか入力してください。"
          }
        }
      }
    },
    "paste.error.webAddress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the HTML or Markdown content itself. Opening web links is not supported here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请粘贴 HTML 或 Markdown 正文。这里不支持直接打开网页链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請貼上 HTML 或 Markdown 內容。這裡不支援直接開啟網頁連結。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTML または Markdown の内容を貼り付けてください。ここから Web リンクを開くことはできません。"
          }
        }
      }
    },
    "paste.error.tooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This text is larger than 2 MB. Open it as a file instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本超过 2 MB，请保存为文件后通过“打开文件”导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字超過 2 MB，請儲存為檔案後透過「開啟檔案」匯入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストが 2 MB を超えています。ファイルに保存してから「ファイルを開く」で読み込んでください。"
          }
        }
      }
    },
    "paste.importSource": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
