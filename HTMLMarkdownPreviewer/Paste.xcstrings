          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在準備預覽…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューを準備中…"
          }
        }
      }
    },
    "paste.cannotPreview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot Preview Text"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法预览文本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法預覽文字"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストをプレビューできません"
          }
        }
      }
    },
    "paste.error.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste or enter some HTML, Markdown, YAML, or JSON text first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先粘贴或输入 HTML、Markdown、YAML 或 JSON 文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先貼上或輸入 HTML、Markdown、YAML 或 JSON 文字。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTML、Markdown、YAML、JSON のテキストを貼り付けるか入力してください。"
          }
        }
      }
    },
    "paste.error.webAddress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the document content itself. Opening web links is not supported here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请粘贴文档内容本身，此处不支持打开网页链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請貼上文件內容本身，此處不支援開啟網頁連結。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文書の内容を貼り付けてください。ここでは Web リンクを開けません。"
          }
        }
      }
    },
    "paste.error.tooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This text is larger than 2 MB. Open it as a file instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本超过 2 MB，请保存为文件后通过“打开文件”导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字超過 2 MB，請儲存為檔案後透過「開啟檔案」匯入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストが 2 MB を超えています。ファイルに保存してから「ファイルを開く」で読み込んでください。"
          }
        }
      }
    },
    "paste.importSource": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
