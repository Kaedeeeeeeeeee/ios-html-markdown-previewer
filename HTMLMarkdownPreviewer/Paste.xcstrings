    "paste.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste HTML, Markdown, YAML, or JSON text here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这里粘贴 HTML、Markdown、YAML 或 JSON 文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此貼上 HTML、Markdown、YAML 或 JSON 文字。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTML、Markdown、YAML、JSON のテキストを貼り付けてください。"
          }
        }
      }
    },
    "paste.contentHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste HTML, Markdown, YAML, or JSON content. Text stays on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴 HTML、Markdown、YAML 或 JSON 内容。文本仅保存在此设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上 HTML、Markdown、YAML 或 JSON 內容。文字只會儲存在此裝置上。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTML、Markdown、YAML、JSON を貼り付けます。テキストはこのデバイス内に保存されます。"
          }
        }
      }
    },
