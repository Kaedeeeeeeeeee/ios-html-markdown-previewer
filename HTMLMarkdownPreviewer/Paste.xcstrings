        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "貼り付けたドキュメント"
          }
        }
      }
    },
    "paste.documentHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTML, JSON objects and arrays, and fenced formats are detected automatically. Choose YAML for plain configuration text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动识别 HTML、JSON 对象与数组及代码块格式。普通配置文本请选择 YAML。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動辨識 HTML、JSON 物件與陣列及程式碼區塊格式。一般設定文字請選擇 YAML。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTML、JSON のオブジェクトと配列、コードブロックの形式を自動判別します。通常の設定テキストには YAML を選んでください。"
          }
        }
      }
    },
    "paste.preview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview"
          }
        },
        "zh-Hans": {
