          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上的文字"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "貼り付けたテキスト"
          }
        }
      }
    }
