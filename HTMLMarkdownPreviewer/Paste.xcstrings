  "strings": {
    "paste.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste to Preview"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴预览"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上預覽"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "貼り付けてプレビュー"
          }
        }
      }
    },
