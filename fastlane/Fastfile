  desc "Read-only verification of pre-synchronized four-locale metadata and 72 modern Asset Library screenshots"
  lane :verify_store_assets do
    # Screenshot mutations use scripts/asset-library/upload_assets.py with an
    # approved plan hash and explicit scope. Never fall back to legacy deliver.
    sh("env", "APP_STORE_CONNECT_CHECK_STORE_ASSETS_ONLY=true", "ruby", ".github/scripts/submit-app-store-review.rb")
  end
end
